{
  "name": "site-sentry",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=1280 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate-cli.ts",
    "worker": "tsx src/worker/crawl-worker.ts",
    "worker:analysis": "tsx src/worker/analysis-worker.ts",
    "worker:render": "tsx src/worker/render-worker.ts",
    "gate:p1": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p1.ts",
    "gate:p2a": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p2a.ts",
    "gate:p2b": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p2b.ts",
    "gate:p3": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p3.ts",
    "gate:p4": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p4.ts",
    "gate:p5": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p5.ts",
    "gate:p6": "node --max-old-space-size=768 --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.data --import tsx scripts/gate-p6.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@tanstack/react-virtual": "3.14.19",
    "axe-core": "4.14.0",
    "bullmq": "6.3.14",
    "cheerio": "^1.2.0",
    "dictionary-en": "^4.0.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "nspell": "^2.1.5",
    "pg": "8.23.1",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "safe-regex2": "^5.1.2",
    "server-only": "^0.0.1",
    "tinyld": "1.3.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nspell": "^2.1.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "13.5.0",
    "selfsigned": "5.5.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
