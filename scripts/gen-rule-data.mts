// Regenerates the vendored rule data from primary sources (run: npx tsx scripts/gen-rule-data.mts):
//   src/lib/rules/data/schema-org.ts      schema.org type and property names (SD-002)
//     from https://schema.org/version/latest/schemaorg-current-https.jsonld
//   src/lib/rules/data/language-codes.ts  hreflang language, script and region subtags (I18N-003)
//     from the IANA Language Subtag Registry, the BCP 47 authority: ISO 639-1 two-letter languages, ISO 15924 scripts
//     and ISO 3166-1 alpha-2 regions, as Google's hreflang documentation requires.
// Each output records its source URL and the date it was fetched. Outputs are committed; the rules never fetch.
import { writeFileSync } from "node:fs";

const SCHEMA_URL = "https://schema.org/version/latest/schemaorg-current-https.jsonld";
const IANA_URL = "https://www.iana.org/assignments/language-subtag-registry/language-subtag-registry";
const today = new Date().toISOString().slice(0, 10);

async function get(url: string): Promise<string> {
  const res = await fetch(url, { headers: { "user-agent": "SiteSentry rule-data generator" } });
  if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`);
  return res.text();
}

const chunked = (names: string[]) => {
  const lines: string[] = [];
  for (let i = 0; i < names.length; i += 12) lines.push(`  ${names.slice(i, i + 12).map((n) => JSON.stringify(n)).join(", ")},`);
  return lines.join("\n");
};

async function schemaOrg() {
  const doc = JSON.parse(await get(SCHEMA_URL)) as { "@graph": { "@id": string; "@type": string | string[] }[] };
  const types: string[] = [];
  const props: string[] = [];
  for (const n of doc["@graph"]) {
    if (!n["@id"].startsWith("schema:")) continue;
    const name = n["@id"].slice("schema:".length);
    const kinds = ([] as string[]).concat(n["@type"]);
    if (kinds.includes("rdf:Property")) props.push(name);
    else if (kinds.includes("rdfs:Class") || kinds.some((k) => k.startsWith("schema:"))) types.push(name); // classes, data types and enumeration members
  }
  types.sort();
  props.sort();
  writeFileSync(
    "src/lib/rules/data/schema-org.ts",
    `// Generated by scripts/gen-rule-data.mts. Do not edit by hand.
// Source: ${SCHEMA_URL} (fetched ${today}). Type names include data types and enumeration members.

export const SCHEMA_ORG_SOURCE = { url: ${JSON.stringify(SCHEMA_URL)}, fetched: ${JSON.stringify(today)} };

export const SCHEMA_TYPES = new Set([
${chunked(types)}
]);

export const SCHEMA_PROPERTIES = new Set([
${chunked(props)}
]);
`,
  );
  console.log(`schema.org: ${types.length} types, ${props.length} properties`);
}

async function languageCodes() {
  const text = await get(IANA_URL);
  const date = /^File-Date: (\S+)/m.exec(text)?.[1] ?? "unknown";
  const out = { language: [] as string[], script: [] as string[], region: [] as string[] };
  for (const rec of text.split(/\n%%\n/)) {
    const field = (k: string) => new RegExp(`^${k}: (.+)$`, "m").exec(rec)?.[1]?.trim();
    const type = field("Type");
    const sub = field("Subtag");
    if (!type || !sub || field("Deprecated") || sub.includes("..")) continue;
    if (type === "language" && /^[a-z]{2}$/.test(sub)) out.language.push(sub);
    if (type === "script" && /^[A-Z][a-z]{3}$/.test(sub)) out.script.push(sub);
    if (type === "region" && /^[A-Z]{2}$/.test(sub)) out.region.push(sub);
  }
  writeFileSync(
    "src/lib/rules/data/language-codes.ts",
    `// Generated by scripts/gen-rule-data.mts. Do not edit by hand.
// Source: ${IANA_URL} (registry File-Date ${date}, fetched ${today}). Deprecated subtags are excluded.
// language: ISO 639-1 (two letters); script: ISO 15924; region: ISO 3166-1 alpha-2.

export const LANGUAGE_CODES_SOURCE = { url: ${JSON.stringify(IANA_URL)}, fileDate: ${JSON.stringify(date)}, fetched: ${JSON.stringify(today)} };

export const LANGUAGES = new Set([
${chunked(out.language)}
]);

export const SCRIPTS = new Set([
${chunked(out.script)}
]);

export const REGIONS = new Set([
${chunked(out.region)}
]);
`,
  );
  console.log(`IANA ${date}: ${out.language.length} languages, ${out.script.length} scripts, ${out.region.length} regions`);
}

await schemaOrg();
await languageCodes();
