# Copy to .env.local: `npm run dev:all` loads it for the app and the workers. Values match docker-compose.yml.

# Crawler v2 (Postgres + Redis + workers) is the default engine; see docs/RUNBOOK.md for how to start it. Only an
# explicit CRAWLER_V2=false selects the legacy in-request engine (100 pages, 3 clicks deep).
CRAWLER_V2=true
DATABASE_URL=postgres://sitesentry:sitesentry@127.0.0.1:5433/sitesentry
REDIS_URL=redis://127.0.0.1:6379

# Existing settings
# SITE_SENTRY_DATA_DIR=.data
# SITE_SENTRY_LIVE_SCANS=enabled
# SITE_SENTRY_ALLOWED_HOSTS=example.com

# Crawler identity (docs/BOT.md). The user-agent is NAME/1.0, plus (+URL) when a URL is set; the name is the robots.txt
# token site owners block. Set both before auditing sites you do not own; there is deliberately no default URL.
# CRAWLER_BOT_NAME=SiteSentryBot
# CRAWLER_BOT_URL=https://example.com/bot

# Header the reverse proxy sets to the client IP. Vercel: x-forwarded-for. Cloudflare: cf-connecting-ip. Default: none,
# and then every forwarding header is ignored (clients can forge them). In production on a public host the homepage
# audit is unavailable until this is set; requests to localhost (and every request outside production) share one
# rate-limit bucket. With x-forwarded-for the rightmost entry is used, so the proxy must append to (or overwrite) it.
# TRUSTED_PROXY_HEADER=

# Bearer token for the admin view of /api/health (configuration problems, e.g. a missing TRUSTED_PROXY_HEADER).
# ADMIN_TOKEN=

# Crawler v2 worker (`npm run worker`). All optional; defaults shown.
# CRAWL_QUEUE_NAME=crawl
# CRAWL_WORKER_CONCURRENCY=4      # crawls one worker process runs at once
# CRAWLER_HOST_CONCURRENCY=3      # requests in flight per host (spec default 3)
# CRAWLER_HOST_RATE=5             # requests per second per host (spec default 5)
# CRAWLER_LEASE_MS=60000          # claim lease; renewed while the worker is alive
# Custom-profile basic auth: 32 random bytes, base64 (openssl rand -base64 32). Needed by the web app (to
# encrypt) and the worker (to decrypt). Without it, basic auth is refused. Never commit a real value.
# CRAWLER_SECRET_KEY=
# CRAWL_JOB_LOCK_MS=25000         # BullMQ lock, renewed every half of it
# CRAWL_JOB_STALLED_MS=15000      # BullMQ stall check; a dead worker's job moves within lock + stall (40 s)
# Render phase (Standard, Full-site and Custom audits that render): headless Chromium, `npx playwright install
# chromium-headless-shell` on the worker host. The crawl worker runs it in-process unless RENDER_WORKER=off; then run
# `npm run worker:render` separately.
# RENDER_QUEUE_NAME=render
# RENDER_BROWSERS=1               # browsers per render worker, 1–4 (each ~150–300 MB)
# RENDER_WORKER=on
# Test/fixture only: map *.test names to loopback and allow extra ports. Honoured only when NODE_ENV=test; the
# worker refuses to start with it under any other NODE_ENV (production, development or unset).
# CRAWLER_LOCAL_HOSTS=site.test=127.0.0.1
# CRAWLER_LOCAL_PORTS=8081
# App store: json (files under .data, the default) or postgres (DATABASE_URL; move existing data with
# npx tsx scripts/migrate-json-store.ts --dry-run, then without --dry-run).
SITE_SENTRY_STORE=json

# AI analysis (opt-in per project, off by default; docs/RUNBOOK.md). Without the provider's key an audit of a project
# with it on records "not configured" and sends nothing.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Default: gemini-flash-latest (gemini), claude-sonnet-5-5 (anthropic).
# AI_ANALYSIS_MODEL=
# The most an audit may send. Page text is shortened, then pages dropped, to fit; if it still cannot, nothing is sent.
# AI_MAX_INPUT_TOKENS=60000
# AI_MAX_OUTPUT_TOKENS=16000
