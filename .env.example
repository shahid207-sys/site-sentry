# Copy to .env.local (Next) and export for the worker. Values match docker-compose.yml.

# Crawler v2 (Postgres + Redis + worker). Off = the legacy in-request engine.
CRAWLER_V2=false
DATABASE_URL=postgres://sitesentry:sitesentry@127.0.0.1:5433/sitesentry
REDIS_URL=redis://127.0.0.1:6379

# Existing settings
# SITE_SENTRY_DATA_DIR=.data
# SITE_SENTRY_LIVE_SCANS=enabled
# SITE_SENTRY_ALLOWED_HOSTS=example.com

# Header the reverse proxy sets to the client IP (e.g. x-forwarded-for, x-real-ip, cf-connecting-ip). Default: none,
# and then every forwarding header is ignored (clients can forge them). In production the homepage audit endpoint
# answers 503 until this is set; elsewhere all clients share one rate-limit bucket. With x-forwarded-for the
# rightmost entry is used, so the proxy must append to (or overwrite) it.
# TRUSTED_PROXY_HEADER=

# Crawler v2 worker (`npm run worker`). All optional; defaults shown.
# CRAWL_QUEUE_NAME=crawl
# CRAWL_WORKER_CONCURRENCY=4      # crawls one worker process runs at once
# CRAWLER_HOST_CONCURRENCY=3      # requests in flight per host (spec default 3)
# CRAWLER_HOST_RATE=5             # requests per second per host (spec default 5)
# CRAWLER_LEASE_MS=60000          # claim lease; renewed while the worker is alive
# Custom-profile basic auth: 32 random bytes, base64 (openssl rand -base64 32). Needed by the web app (to
# encrypt) and the worker (to decrypt). Without it, basic auth is refused. Never commit a real value.
# CRAWLER_SECRET_KEY=
# CRAWL_JOB_LOCK_MS=30000         # BullMQ lock; a dead worker's job is redelivered after this
# Test/fixture only: map *.test names to loopback and allow extra ports. Honoured only when NODE_ENV=test; the
# worker refuses to start with it under any other NODE_ENV (production, development or unset).
# CRAWLER_LOCAL_HOSTS=site.test=127.0.0.1
# CRAWLER_LOCAL_PORTS=8081
